{
  "name": "langedudei",
  "version": "1.0.0",
  "description": "LangEduDei – aplikacja do nauki angielskiego A1–C2 z przewodnikiem Kurakiem i lektorem AI (metody Doma)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:mobile": "node scripts/build-mobile.mjs",
    "android:sync": "npm run build:mobile && npx cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-apk.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "msedge-tts": "^2.1.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2",
    "wrangler": "^4.151.1"
  }
}
